+def bounding_box_bounds(shape: TopoDS_Shape):
+    """`(xmin, ymin, zmin, xmax, ymax, zmax)` of a shape's bounding box.
+
+    `Bnd_Box.Get()` resolves to the overload returning the `Limits` struct, which
+    is not bound, so read the six bounds individually.
+    """
+    bbox = bounding_box(shape)
+    return (
+        bbox.GetXMin(),
+        bbox.GetYMin(),
+        bbox.GetZMin(),
+        bbox.GetXMax(),
+        bbox.GetYMax(),
+        bbox.GetZMax(),
+    )
+
+
